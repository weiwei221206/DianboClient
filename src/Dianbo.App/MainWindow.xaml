                  <StackPanel Padding="16" Spacing="4">
                    <TextBlock Text="项目地址" Style="{StaticResource RowTitle}" />
                    <HyperlinkButton Content="GitHub · DianboClient" NavigateUri="https://github.com/weiwei221206/DianboClient" Padding="0" HorizontalAlignment="Left" AutomationProperties.Name="在浏览器中打开 GitHub 项目地址" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                  <StackPanel Padding="16" Spacing="8">
                    <TextBlock Text="使用说明" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="本项目使用第官方服务接口，接口行为可能变化。请遵守相关服务条款，并仅播放自己有权访问的内容。仅供学习交流，严禁用于商业用途。" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>

            <Grid PointerWheelChanged="PlayingPage_PointerWheelChanged" x:Name="PlayingPage" SizeChanged="PlayingPage_SizeChanged"
                  Background="Transparent"
                  Visibility="Collapsed"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Margin="16,12,16,12">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="PlayingTransform" />
              </Grid.RenderTransform>

              <Grid x:Name="PlayingHost" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <Grid x:Name="PlayingCoverPage" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <Grid.RenderTransform>
                    <TranslateTransform x:Name="CoverPageTransform" />
                  </Grid.RenderTransform>

                  <Grid x:Name="CoverPageLayoutGrid" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="CoverLayoutCol0" Width="*" />
                      <ColumnDefinition x:Name="CoverLayoutCol1" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition x:Name="CoverLayoutRow0" Height="*" />
                      <RowDefinition x:Name="CoverLayoutRow1" Height="0" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="CoverSectionGrid"
                          Background="Transparent"
                          Grid.Column="0"
                          Grid.Row="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="16">
                      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="PlayingCoverContainer"
                              Width="440"
                              Height="440"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                          <Border CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <FontIcon x:Name="CoverPlaceholderIcon" Glyph="&#xEC4F;" FontSize="64" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border CornerRadius="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Image x:Name="NowPlayingCover" Stretch="UniformToFill" />
                          </Border>
                          <Border x:Name="NowPlayingBufferingOverlay" CornerRadius="20" Background="#55000000" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                              <ProgressRing IsActive="True" Width="36" Height="36" Foreground="White" />
                              <TextBlock Text="正在缓冲…" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Viewbox>
                    </Grid>
                    <Grid x:Name="InfoAndControlsGrid"
                          Background="Transparent"
                          Grid.Column="1"
                          Grid.Row="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="16,8">
                      <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel x:Name="ControlsContentPanel"
                                    Background="Transparent"
                                    Width="420"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8"
                                    Padding="4,2">

                          <!-- 歌曲元数据信息 -->
                          <StackPanel x:Name="TrackMetaPanel" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="NowPlayingTitle" Text="点波音乐" FontSize="22" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingArtist" Text="发现好音乐，享受当下" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="NowPlayingAlbum" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxLines="1" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <!-- 音质胶囊标签 -->
                            <Button Click="NowPlayingQualityBadge_Click" x:Name="NowPlayingQualityBadge"
                                                                        
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    MinWidth="0"
                                    MinHeight="22"
                                    HorizontalAlignment="Center"
                                    Margin="0,2,0,0"
                                    Visibility="Collapsed"
                                    ToolTipService.ToolTip="点击切换播放音质或前往设置">
                              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="NowPlayingQualityText" Text="标准品质 · MP3" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </StackPanel>

                          <!-- 播放时间轴 -->
                          <StackPanel x:Name="SeekPanel" Spacing="2" Margin="0,2,0,0">
                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" StepFrequency="1" IsEnabled="False" AutomationProperties.Name="播放进度" HorizontalAlignment="Stretch" />
                            <Grid Margin="2,-4,2,0">
                              <TextBlock x:Name="PositionText" Text="0:00" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" />
                              <TextBlock x:Name="DurationText" Text="0:00" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                          </StackPanel>

                          <!-- 主控制按钮栏 -->
                          <StackPanel x:Name="MainControlsBar" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                            <!-- 收藏 / 取消收藏按钮 -->
                            <Button Click="PlayingFavorite_Click" x:Name="PlayingFavoriteButton"
                                                                 
                                    IsEnabled="False"
                                    Width="34" Height="34" Padding="0"
                                    CornerRadius="17"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="添加收藏"
                                    AutomationProperties.Name="收藏当前歌曲">
                              <FontIcon x:Name="PlayingFavoriteIcon" Glyph="&#xEB51;" FontSize="15" Foreground="{ThemeResource FavoriteUncheckedBrush}" />
                            </Button>
                            <!-- 播放模式切换按钮 -->
                            <Button Click="PlayModeButton_Click" x:Name="PlayModeButton"                              Width="34" Height="34" Padding="0" CornerRadius="17" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="列表循环" AutomationProperties.Name="播放模式">
                              <FontIcon x:Name="PlayModeIcon" Glyph="&#xE8EE;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <!-- 上一首 -->
                            <Button Click="Previous_Click" x:Name="PreviousButton"                        IsEnabled="False" Width="38" Height="38" Padding="0" CornerRadius="19" ToolTipService.ToolTip="上一首" AutomationProperties.Name="上一首">
                              <FontIcon Glyph="&#xE892;" FontSize="15" />
                            </Button>
                            <!-- 播放/暂停（大号 Accent 按钮） -->
                            <Button Click="PlayPause_Click" x:Name="PlayPauseButton"                         IsEnabled="False" Width="50" Height="50" CornerRadius="25" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="播放" AutomationProperties.Name="播放或暂停">
                              <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <!-- 下一首 -->
                            <Button Click="Next_Click" x:Name="NextButton"                    IsEnabled="False" Width="38" Height="38" Padding="0" CornerRadius="19" ToolTipService.ToolTip="下一首" AutomationProperties.Name="下一首">
                              <FontIcon Glyph="&#xE893;" FontSize="15" />
                            </Button>




                            <!-- 查看播放队列 -->
                            <Button Click="PlayingQueue_Click" x:Name="PlayingQueueButton"                            Width="34" Height="34" Padding="0" CornerRadius="17" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="查看播放队列" AutomationProperties.Name="查看播放队列">
                              <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <!-- 更多操作 -->
                            <Button Click="PlayingMore_Click" x:Name="PlayingMoreButton"                           IsEnabled="False" Width="34" Height="34" Padding="0" CornerRadius="17" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作">
                              <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                          </StackPanel>

                          <!-- 音量控制栏 -->
                          <Grid x:Name="VolumeGrid" HorizontalAlignment="Center" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Click="MuteButton_Click" x:Name="MuteButton"                          Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="16" ToolTipService.ToolTip="静音 / 恢复" AutomationProperties.Name="静音切换">
                              <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Slider ValueChanged="VolumeSlider_ValueChanged" x:Name="VolumeSlider" Grid.Column="1" Width="120" Minimum="0" Maximum="100" StepFrequency="1"                                          AutomationProperties.Name="音量" VerticalAlignment="Center" />
                            <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="" FontSize="11" Width="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                          </Grid>

                          <Button Click="CoverToLyricsButton_Click" x:Name="CoverToLyricsButton"
                                                                   
                                  HorizontalAlignment="Center"
                                  Margin="0,2,0,0"
                                  Padding="14,6"
                                  CornerRadius="15"
                                  Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                  ToolTipService.ToolTip="滚动鼠标滚轮或点击切换至歌词页">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <FontIcon x:Name="CoverToLyricsIcon" Glyph="&#xE70D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              <TextBlock x:Name="CoverToLyricsText" Text="向下滚动查看歌词" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                          </Button>

                          <InfoBar x:Name="NowPlayingInfoBar" Severity="Error" IsOpen="False" IsClosable="True" Margin="0,2,0,0" />

                        </StackPanel>
                      </Viewbox>
                    </Grid>
                  </Grid>
                </Grid>

                <Grid x:Name="PlayingLyricsPage" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
                  <Grid.RenderTransform>
                    <TranslateTransform x:Name="LyricsPageTransform" />
                  </Grid.RenderTransform>

                  <Border x:Name="LyricsCardBorder"
                          CornerRadius="16"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Margin="12,6,12,10">

                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>

                      <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 返回封面按钮 -->
                        <Button Click="LyricsBackToCoverButton_Click" x:Name="LyricsBackToCoverButton"
                                                                     
                                Padding="10,5"
                                CornerRadius="14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                ToolTipService.ToolTip="返回封面页（或使用鼠标滚轮切换）">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="LyricsBackToCoverIcon" Glyph="&#xE70E;" FontSize="11" />
                            <TextBlock x:Name="LyricsBackToCoverText" Text="返回封面" FontSize="12" />
                          </StackPanel>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock x:Name="LyricsHeader" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                        </StackPanel>

                        <!-- 翻译开关按钮 -->
                        <ToggleButton Click="TranslationToggle_Click" x:Name="TranslationToggle" Grid.Column="2" Content="译"                                 Width="32" Height="28" Padding="0" CornerRadius="6" FontSize="11" ToolTipService.ToolTip="显示/隐藏翻译歌词" AutomationProperties.Name="显示翻译歌词" />

                        <Button Click="LyricsToggle_Click" x:Name="LyricsFollowButton" Grid.Column="3"                            ToolTipService.ToolTip="定位当前演唱行并恢复自动跟随" AutomationProperties.Name="定位当前歌词" Padding="8,4" CornerRadius="6" FontSize="11">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8D6;" FontSize="11" />
                            <TextBlock x:Name="LyricsFollowStatusText" Text="跟随中" FontSize="11" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <!-- 歌词内翻页核心视口 -->
                      <Grid SizeChanged="LyricsScrollArea_SizeChanged" Grid.Row="1" x:Name="LyricsScrollArea" Background="Transparent"                                           >
                        <ListView ItemClick="LyricsList_ItemClick" Loaded="LyricsList_Loaded" x:Name="LyricsList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                                                  
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  BorderThickness="0"
                                  Padding="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                            
                                                                                      >
                          <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                              <Setter Property="Padding" Value="0" />
                              <Setter Property="Margin" Value="0" />
                              <Setter Property="MinHeight" Value="0" />
                            </Style>
                          </ListView.ItemContainerStyle>
                          <ListView.ItemTemplate>
                            <DataTemplate>
                              <Grid Background="Transparent" PointerEntered="LyricRow_PointerEntered" PointerExited="LyricRow_PointerExited">
                                <StackPanel Spacing="4" Padding="88,10" HorizontalAlignment="Stretch" Opacity="{Binding Opacity}">
                                  <TextBlock Text="{Binding Original}"
                                             TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             HorizontalAlignment="Center"
                                             FontSize="{Binding FontSize}"
                                             Foreground="{Binding Foreground}"
                                             FontWeight="{Binding FontWeight}" />
                                  <TextBlock Text="{Binding Translation}"
                                             TextWrapping="Wrap"
                                             TextAlignment="Center"
                                             HorizontalAlignment="Center"
                                             FontSize="13"
                                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                             Visibility="{Binding TranslationVisibility}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Timestamp}"
                                           Visibility="{Binding TimestampVisibility}"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              </Grid>
                            </DataTemplate>
                          </ListView.ItemTemplate>
                        </ListView>

                        <!-- 歌词空状态占位展示 -->
                        <StackPanel x:Name="LyricsEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Visibility="Collapsed" Padding="24">
                          <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center">
                            <FontIcon x:Name="LyricsEmptyIcon" Glyph="&#xEC4F;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="LyricsEmptyTitle" Text="暂无播放中的音乐" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LyricsEmptySubtitle" Text="从发现音乐或搜索中挑选一首歌开始聆听" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>

                    </Grid>
                  </Border>
                </Grid>

              </Grid>
            </Grid>

      </Grid>
    </NavigationView>
  </Grid>
</Window>

