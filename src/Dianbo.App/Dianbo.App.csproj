<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Dianbo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!--
      必须开启：dotnet publish 默认不会把 WinUI 的资源索引 Dianbo.pri 和编译后的 XAML 带进发布目录，
      结果是发布版一启动就在 Microsoft.UI.Xaml.dll 里崩溃（0xc000027b），而 dotnet build 的输出却正常。
      开启后 dotnet publish 会走 MSIX tooling 的 PRI 生成流程，发布产物才和构建产物一样可用。
    -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Dianbo</AssemblyName>
    <Product>点波音乐</Product>
    <!-- 版本号统一在根目录 Directory.Build.props 里维护。 -->
    <!-- 二维码像素写入 WriteableBitmap 需要 IBufferByteAccess 指针访问。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <Content Include="..\..\assets\logo.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\app.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dianbo.Core\Dianbo.Core.csproj" />
    <ProjectReference Include="..\Dianbo.Infrastructure\Dianbo.Infrastructure.csproj" />
  </ItemGroup>
</Project>
