<Window x:Class="Dianbo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="点波音乐">
  <Window.SystemBackdrop>
    <MicaBackdrop Kind="BaseAlt" />
  </Window.SystemBackdrop>
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppTitleBar"
          Grid.Row="0"
          Height="48"
          Background="Transparent"
          VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="TitleBarLeftPaddingColumn" Width="0" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="TitleBarRightPaddingColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="1"
                  x:Name="AppTitleBarBrand"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Margin="16,0,0,0"
                  Spacing="12">
        <Image x:Name="AppTitleBarIcon"
               Source="Assets/logo.png"
               Width="16"
               Height="16"
               VerticalAlignment="Center"
               Stretch="Uniform" />
        <TextBlock x:Name="AppTitleBarText"
                   Text="点波音乐"
                   FontSize="12"
                   FontWeight="Normal"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
      </StackPanel>

      <Border Grid.Column="2" Background="Transparent" />
    </Grid>

    <NavigationView ItemInvoked="Navigation_ItemInvoked" SelectionChanged="Navigation_SelectionChanged" Expanding="Navigation_Expanding" Collapsed="Navigation_Collapsed" x:Name="Navigation"
                    Grid.Row="1"
                    IsTitleBarAutoPaddingEnabled="False"
                    PaneDisplayMode="Left"
                    OpenPaneLength="240"
                    CompactPaneLength="48"
                    IsPaneToggleButtonVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    IsPaneOpen="True"
                                                        
                                                                  
                                                    
                                                    
                    AlwaysShowHeader="False">
      <NavigationView.PaneHeader>
        <Border Height="6" />
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="DiscoverNav" Content="发现音乐" Tag="discover"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Name="SearchNav" Content="搜索" Tag="search" Icon="Find" />
        <NavigationViewItemSeparator />
        <NavigationViewItem Loaded="LibraryNav_Loaded" x:Name="LibraryNav" Content="我的音乐" Tag="library" IsExpanded="True"                           >
          <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon>
          <NavigationViewItem.MenuItems>
            <NavigationViewItem DoubleTapped="NavFond_DoubleTapped" x:Name="NavFond" Content="我喜欢的音乐" Tag="library:fond"                                    >
              <NavigationViewItem.Icon><FontIcon Glyph="&#xEB52;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem DoubleTapped="NavRecent_DoubleTapped" x:Name="NavRecent" Content="最近播放" Tag="library:recent"                                      >
              <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
          </NavigationViewItem.MenuItems>
        </NavigationViewItem>
        <NavigationViewItem x:Name="QueueNav" Content="播放队列" Tag="queue"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="PlayingNav" Content="正在播放" Tag="playing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <NavigationView.PaneFooter>
        <StackPanel Margin="4,0,4,8">
          <NavigationViewItemSeparator Margin="-4,0,-4,6" />
          <Button Click="PaneAccount_Click" x:Name="PaneAccount" Style="{StaticResource PaneAccountButton}"                           AutomationProperties.Name="登录与账号" ToolTipService.ToolTip="登录与账号">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border x:Name="PaneAccountAvatarBorder" Width="40" Height="40" CornerRadius="20" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <FontIcon x:Name="PaneAccountAvatarIcon" Glyph="&#xE77B;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PaneAccountTitle" Text="未登录" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PaneAccountDetail" Text="登录后同步喜欢的音乐" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </NavigationView.PaneFooter>

      <Grid x:Name="ContentRootGrid">
        <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid.Resources>
          <ControlTemplate x:Key="SettingsSubHeader" TargetType="ContentControl">
            <Grid ColumnSpacing="14" Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Click="SettingsBack_Click" Style="{StaticResource BackButton}"                            ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
              </Button>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <HyperlinkButton Click="SettingsBreadcrumbRoot_Click" Content="设置" Style="{StaticResource BreadcrumbLink}"                                      />
                <FontIcon Style="{StaticResource BreadcrumbChevron}" />
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource BreadcrumbCurrent}" />
              </StackPanel>
            </Grid>
          </ControlTemplate>


          <ControlTemplate x:Key="LyricsSettingsSubHeader" TargetType="ContentControl">
            <Grid ColumnSpacing="14" Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Click="SettingsBack_Click" Style="{StaticResource BackButton}" ToolTipService.ToolTip="返回歌词设置" AutomationProperties.Name="返回歌词设置">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
              </Button>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <HyperlinkButton Click="SettingsBreadcrumbSettings_Click" Content="设置" Style="{StaticResource BreadcrumbLink}" />
                <FontIcon Style="{StaticResource BreadcrumbChevron}" />
                <HyperlinkButton Click="SettingsBreadcrumbLyrics_Click" Content="歌词" Style="{StaticResource BreadcrumbLink}" />
                <FontIcon Style="{StaticResource BreadcrumbChevron}" />
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource BreadcrumbCurrent}" />
              </StackPanel>
            </Grid>
          </ControlTemplate>


          <ControlTemplate x:Key="LibrarySubHeader" TargetType="ContentControl">
            <Grid ColumnSpacing="14" Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button Click="LibraryBack_Click" Style="{StaticResource BackButton}"                           ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
              </Button>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <HyperlinkButton Click="LibraryBreadcrumbRoot_Click" Content="我的音乐" Style="{StaticResource BreadcrumbLink}"                                     />
                <FontIcon Style="{StaticResource BreadcrumbChevron}" />
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource BreadcrumbCurrent}" />
              </StackPanel>
            </Grid>
          </ControlTemplate>

          <Style x:Key="SongItemFavoriteButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>


          <Style x:Key="SongItemMoreButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>


          <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
          </Style>
          <Style x:Key="SettingsCardButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
          </Style>
          <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,10,0,0" />
          </Style>
          <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="LineHeight" Value="20" />
          </Style>
          <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
          </Style>

  
          <Style x:Key="SettingsExpanderHeader" TargetType="ToggleButton">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid x:Name="Root" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1" /></Storyboard></VisualState>
                        <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.05" /></Storyboard></VisualState>
                        <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" /></Storyboard></VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Expander">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ToggleButton x:Name="ExpanderHeaderButton" Margin="4,0" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource SettingsExpanderHeader}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                    <ContentPresenter x:Name="ExpanderContent" Grid.Row="1" HorizontalAlignment="Stretch" Visibility="Collapsed" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </Grid>
                  <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ExpanderStates">
                      <VisualState x:Name="Collapsed">
                        <Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpanderContent" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" /></ObjectAnimationUsingKeyFrames></Storyboard>
                      </VisualState>
                      <VisualState x:Name="Expanded">
                        <Storyboard><ObjectAnimationUsingKeyFrames Storyboard.TargetName="ExpanderContent" Storyboard.TargetProperty="Visibility"><DiscreteObjectKeyFrame KeyTime="0" Value="Visible" /></ObjectAnimationUsingKeyFrames></Storyboard>
                      </VisualState>
                    </VisualStateGroup>
                  </VisualStateManager.VisualStateGroups>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>


          <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Grid x:Name="Root" Background="Transparent" CornerRadius="4">
                    <Border x:Name="Hover" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0" CornerRadius="4" />
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1" /></Storyboard></VisualState>
                        <VisualState x:Name="Pressed"><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.05" /></Storyboard></VisualState>
                        <VisualState x:Name="Disabled"><Storyboard><DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" /></Storyboard></VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>


          <Style x:Key="BreadcrumbLink" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="HyperlinkButton">
                  <Grid x:Name="Root" Background="Transparent">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}" />
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                          <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                          <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                          <VisualState.Setters>
                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                          </VisualState.Setters>
                        </VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
          <Style x:Key="BreadcrumbChevron" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
          </Style>
          <Style x:Key="BreadcrumbCurrent" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
          </Style>


          <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
          </Style>
          <Style x:Key="RowIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
          </Style>
          <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
          </Style>
          <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
          </Style>

          <Style x:Key="SettingsComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="230" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
          <Style x:Key="SettingsToggle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </Grid.Resources>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="PageContentHost" Margin="32,24,36,24">
            <!-- 发现音乐 -->
            <StackPanel x:Name="DiscoverPage" Spacing="24" VerticalAlignment="Top">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="DiscoverTransform" />
              </StackPanel.RenderTransform>

              <StackPanel Spacing="6">
                <TextBlock Text="发现音乐" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="从一首歌开始，找到今天的节奏。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <InfoBar x:Name="DiscoverOfflineInfoBar" IsOpen="False" Severity="Informational" IsClosable="False"
                       Title="当前处于离线模式"
                       Message="网络不可用，无法加载在线推荐内容。您可以前往“我的音乐”畅享本地缓存的歌曲与自建歌单。"
                       Margin="2,0,2,0">
                <InfoBar.ActionButton>
                  <Button Content="重试" Click="RefreshDiscoverSongs_Click" />
                </InfoBar.ActionButton>
              </InfoBar>

              <!-- 推荐歌曲板块 -->
              <StackPanel Spacing="12">
                <Grid Margin="2,0,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource IconBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="推荐歌曲" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressRing x:Name="DiscoverSongsRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Margin="2,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="PlayRandomDiscoverSong_Click" x:Name="PlayRandomDiscoverSongBtn" Padding="14,6" CornerRadius="8" ToolTipService.ToolTip="按个性化推荐随机播放单曲，下一首继续推荐新歌">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B1;" FontSize="12" />
                        <TextBlock Text="随机单曲" VerticalAlignment="Center" FontSize="13" />
                      </StackPanel>
                    </Button>
                    <Button Click="PlayAllDiscoverSongs_Click" x:Name="PlayAllDiscoverSongsBtn"                                    Style="{ThemeResource AccentButtonStyle}" Padding="14,6" CornerRadius="8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                        <TextBlock Text="播放全部" VerticalAlignment="Center" FontSize="13" />
                      </StackPanel>
                    </Button>
                    <Button Click="RefreshDiscoverSongs_Click" x:Name="RefreshDiscoverSongsBtn"                                    ToolTipService.ToolTip="换一批推荐歌曲" Padding="12,6" CornerRadius="8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="换一批" VerticalAlignment="Center" FontSize="13" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingsCard}" Padding="6">
                  <ListView ItemClick="DiscoverSong_ItemClick" x:Name="DiscoverSongsList" SelectionMode="None" IsItemClickEnabled="True"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="6,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Click="PlayDiscoverSong_Click" Content="播放"                                Tag="{Binding Id}" Padding="12,5" />
                            <Button Click="FavoriteSong_Click" Style="{StaticResource SongItemFavoriteButton}"
                                                              
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="{Binding FavoriteTooltip}"
                                    AutomationProperties.Name="{Binding FavoriteTooltip}">
                              <FontIcon Glyph="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" FontSize="14" />
                            </Button>
                            <Button Click="SongMore_Click" Style="{StaticResource SongItemMoreButton}"
                                                          
                                    Tag="{Binding}"
                                    ToolTipService.ToolTip="更多操作"
                                    AutomationProperties.Name="更多操作">
                              <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <TextBlock Text="{Binding DurationText}" FontSize="12" Width="40" TextAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Border>
              </StackPanel>

              <!-- 推荐歌单板块 -->
              <StackPanel Spacing="12">
                <Grid Margin="2,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B9;" FontSize="18" Foreground="{ThemeResource IconBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="精选推荐歌单" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ProgressRing x:Name="DiscoverPlaylistsRing" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Margin="2,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <Button Click="RefreshDiscoverPlaylists_Click" Grid.Column="1" x:Name="RefreshDiscoverPlaylistsBtn"                                        ToolTipService.ToolTip="换一批精选歌单" Padding="12,6" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE72C;" FontSize="12" />
