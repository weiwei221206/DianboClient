                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="80" Height="80" CornerRadius="8" Background="{ThemeResource ControlFillColorDefaultBrush}">
                      <Image x:Name="DetailPlaylistCover" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                      <TextBlock x:Name="DetailPlaylistTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="DetailPlaylistSubtitle" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Click="DeleteDetailPlaylist_Click" x:Name="DeleteDetailPlaylistButton"                                    Padding="14,8" ToolTipService.ToolTip="删除当前歌单" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE74D;" FontSize="13" />
                          <TextBlock Text="删除歌单" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Click="PlayShuffleDetailPlaylist_Click"                                         Padding="14,8" ToolTipService.ToolTip="开启随机模式并播放歌单所有歌曲">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                          <TextBlock Text="随机播放" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Click="PlayAllDetailPlaylist_Click"                                     Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="&#xE768;" FontSize="13" />
                          <TextBlock Text="播放全部" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

                <ListView ItemClick="DetailPlaylistSong_ItemClick" x:Name="DetailPlaylistSongsList" SelectionMode="Single" IsItemClickEnabled="True"                                         
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          Margin="0,0,0,48">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Click="PlayDetailSong_Click" Content="播放"                              Tag="{Binding Id}" />
                          <Button Click="FavoriteSong_Click" Style="{StaticResource SongItemFavoriteButton}"
                                                            
                                  Tag="{Binding}"
                                  ToolTipService.ToolTip="{Binding FavoriteTooltip}"
                                  AutomationProperties.Name="{Binding FavoriteTooltip}">
                            <FontIcon Glyph="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" FontSize="14" />
                          </Button>
                          <Button Click="SongMore_Click" Style="{StaticResource SongItemMoreButton}"
                                                        
                                  Tag="{Binding}"
                                  ToolTipService.ToolTip="更多操作"
                                  AutomationProperties.Name="更多操作">
                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          </Button>
                          <TextBlock Text="{Binding DurationText}" FontSize="12" Width="40" TextAlignment="Right"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </Grid>

            <!-- 播放队列 -->
            <StackPanel x:Name="QueuePage" Visibility="Collapsed" Spacing="18" VerticalAlignment="Top">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="QueueTransform" />
              </StackPanel.RenderTransform>

              <!-- 队列标题区 -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                  <TextBlock Text="播放队列" FontSize="30" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="QueueCountText" Text="共 0 首歌曲" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="QueuePlayingDot" Text="·" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="QueueCurrentPlayingText" Text="" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" Visibility="Collapsed" />
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- 队列空状态展示卡片 -->
              <Border x:Name="QueueEmptyCard" Style="{StaticResource SettingsCard}" MinHeight="360" Padding="32,48">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="480">
                  <Border Width="84" Height="84" CornerRadius="42"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE93C;" FontSize="38"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="播放队列为空" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="当前暂无播放或待播放的歌曲。挑选一首喜欢的音乐，开启美妙的声音旅程吧。"
                               FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel x:Name="QueueContentArea" Spacing="14" Visibility="Collapsed">
                <!-- 顶部控制工具栏卡片 -->
                <Border Style="{StaticResource SettingsCard}" Padding="14,12">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 播放模式选择下拉菜单 -->
                    <Button Grid.Column="0" x:Name="QueuePlayModeMenuBtn" Padding="14,8" ToolTipService.ToolTip="切换播放模式（顺序播放、列表循环、单曲循环、随机播放）">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuFlyoutItem Click="QueuePlayModeItem_Click" Text="顺序播放"                                 Tag="Sequential">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF5E7;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutItem Click="QueuePlayModeItem_Click" Text="列表循环"                                 Tag="RepeatAll">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EE;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutItem Click="QueuePlayModeItem_Click" Text="单曲循环"                                 Tag="RepeatOne">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8ED;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                          <MenuFlyoutItem Click="QueuePlayModeItem_Click" Text="随机播放"                                 Tag="Shuffle">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B1;" /></MenuFlyoutItem.Icon>
                          </MenuFlyoutItem>
                        </MenuFlyout>
                      </Button.Flyout>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="QueuePlayModeIcon" Glyph="&#xE8EE;" FontSize="13" />
                        <TextBlock x:Name="QueuePlayModeText" Text="列表循环" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- 定位当前播放 -->
                    <Button Click="QueueLocateCurrent_Click" Grid.Column="2" x:Name="QueueLocateCurrentBtn"                                  Padding="12,8" ToolTipService.ToolTip="滚动并定位到当前正在播放的歌曲">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8D6;" FontSize="13" />
                        <TextBlock Text="定位当前" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- 清空队列 -->
                    <Button Click="QueueClear_Click" Grid.Column="3" x:Name="QueueClearBtn"                          Padding="12,8" ToolTipService.ToolTip="清空播放队列中的所有歌曲">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        <TextBlock Text="清空队列" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>

                <!-- 歌曲列表 -->
                <ListView ItemClick="QueueSong_ItemClick" x:Name="QueueListView" SelectionMode="Single" IsItemClickEnabled="True"                                
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          Margin="0,0,0,48">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12" Padding="4,6">
                        <Grid.ContextFlyout>
                          <MenuFlyout>
                            <MenuFlyoutItem Click="QueueContextPlay_Click" Text="立即播放"                                Tag="{Binding}">
                              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="QueueContextRemove_Click" Text="从队列移除"                                  Tag="{Binding}">
                              <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="FavoriteSong_Click" Text="{Binding FavoriteTooltip}"                            Tag="{Binding}">
                              <MenuFlyoutItem.Icon><FontIcon Glyph="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                          </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayIndex}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IndexVisibility}" />
                          <FontIcon Glyph="&#xE767;" FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding PlayingIndicatorVisibility}" />
                        </Grid>

                        <!-- 专辑封面 -->
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="4" Background="{ThemeResource ControlFillColorDefaultBrush}">
                          <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />
                        </Border>

                        <!-- 歌名与歌手 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                                     Foreground="{Binding TitleForeground}" FontWeight="{Binding TitleFontWeight}" />
                          <TextBlock Text="{Binding Artist}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 操作按钮区 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Click="PlayQueueSong_Click" Content="播放"                             Tag="{Binding}" />
                          <Button Click="FavoriteSong_Click" Style="{StaticResource SongItemFavoriteButton}"
                                                            
                                  Tag="{Binding}"
                                  ToolTipService.ToolTip="{Binding FavoriteTooltip}"
                                  AutomationProperties.Name="{Binding FavoriteTooltip}">
                            <FontIcon Glyph="{Binding FavoriteGlyph}" Foreground="{Binding FavoriteBrush}" FontSize="14" />
                          </Button>
                          <Button Click="SongMore_Click" Style="{StaticResource SongItemMoreButton}"
                                                        
                                  Tag="{Binding}"
                                  ToolTipService.ToolTip="更多操作"
                                  AutomationProperties.Name="更多操作">
                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          </Button>
                          <Button Click="RemoveQueueSong_Click" Style="{StaticResource SongItemFavoriteButton}"
                                                               
                                  Tag="{Binding}"
                                  ToolTipService.ToolTip="从队列移除"
                                  AutomationProperties.Name="从队列移除">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                          </Button>
                          <TextBlock Text="{Binding DurationText}" FontSize="12" Width="40" TextAlignment="Right"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </StackPanel>



            <!-- 设置 -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed" VerticalAlignment="Top">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="SettingsTransform" />
              </Grid.RenderTransform>
              <StackPanel x:Name="SettingsCategories" Spacing="4" VerticalAlignment="Top">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:Name="CategoriesTransform" />
                </StackPanel.RenderTransform>
                <StackPanel Spacing="6" Margin="0,0,0,16">
                  <TextBlock Text="设置" FontSize="30" FontWeight="SemiBold" />
                  <TextBlock Text="管理点波音乐的偏好设置。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-account"                                AutomationProperties.Name="登录与账号" Margin="0,0,0,4">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="AccountStateAvatarBorder" Width="44" Height="44" CornerRadius="22" Background="{ThemeResource ControlFillColorDefaultBrush}">
                      <FontIcon x:Name="AccountStateAvatarIcon" Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock x:Name="AccountStateTitle" Text="未登录" Style="{StaticResource RowTitle}" FontSize="15" />
                      <TextBlock x:Name="AccountStateDetail" Text="登录后同步喜欢的音乐并恢复会话" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="登录与账号" Style="{StaticResource RowValue}" Margin="0,0,8,0" />
                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-general" AutomationProperties.Name="常规设置">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource ControlFillColorDefaultBrush}"><FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="常规设置" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="开机自启、启动播放与关闭行为" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-playback"                                AutomationProperties.Name="播放与音质">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource ControlFillColorDefaultBrush}"><FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="播放与音质" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="播放音质、播放行为与系统媒体键" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-lyrics" AutomationProperties.Name="歌词">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource ControlFillColorDefaultBrush}"><FontIcon Glyph="&#xE8A2;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="歌词" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="主界面歌词与任务栏歌词" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-appearance" AutomationProperties.Name="外观">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource ControlFillColorDefaultBrush}"><FontIcon Glyph="&#xE790;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="外观" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="应用主题与深色模式" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-storage"                                AutomationProperties.Name="存储、缓存与日志">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource ControlFillColorDefaultBrush}"><FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="存储、缓存与日志" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="数据位置、会话文件与脱敏日志" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>

                <Button Click="SettingsNavigate_Click" Style="{StaticResource SettingsCardButton}" Tag="settings-about" AutomationProperties.Name="关于">
                  <Grid Padding="16,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" Source="ms-appx:///Assets/logo.png" Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="关于点波音乐" Style="{StaticResource RowTitle}" />
                      <TextBlock Text="项目地址、使用说明与版本信息" Style="{StaticResource RowDescription}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="1.0.3" Style="{StaticResource RowValue}" Margin="0,0,8,0" />
                    <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="12" Style="{StaticResource RowIcon}" />
                  </Grid>
                </Button>
              </StackPanel>

              <StackPanel x:Name="SettingsAccount" Visibility="Collapsed" Spacing="10" VerticalAlignment="Top">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:Name="AccountTransform" />
                </StackPanel.RenderTransform>
                <ContentControl Template="{StaticResource SettingsSubHeader}" Tag="登录与账号" />
                <TextBlock Text="二维码登录、会话恢复与本地退出。" Style="{StaticResource BodyText}" />
                <Border Style="{StaticResource SettingsCard}">
                  <StackPanel>
                    <Grid Padding="16,13">
                      <StackPanel Spacing="3">
                        <TextBlock Text="登录状态" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="AccountStatusText" Text="尚未登录。" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Separator}" />
                    <Grid Padding="16,13" ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="登录点波音乐" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="使用手机端扫码确认，二维码只在当前窗口显示，可刷新或取消。" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                      <Button Click="Login_Click" x:Name="SignInButton" Grid.Column="1" Content="登录"                     VerticalAlignment="Center" MinWidth="100" />
                    </Grid>
                    <Border Style="{StaticResource Separator}" />
                    <Grid Padding="16,13" ColumnSpacing="16">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="退出登录" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="清除本机保存的会话并停止播放；不会注销其他设备。" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                      <Button Click="SignOut_Click" x:Name="SignOutButton" Grid.Column="1" Content="退出登录"                       IsEnabled="False" MinWidth="100" />
                    </Grid>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="SessionLocationText" Text="会话使用当前用户加密保存；日志不记录票据或账号原值。" Style="{StaticResource CaptionText}" />
              </StackPanel>

              <StackPanel x:Name="SettingsGeneral" Visibility="Collapsed" Spacing="10" VerticalAlignment="Top">
                <StackPanel.RenderTransform>
                  <TranslateTransform x:Name="GeneralTransform" />
                </StackPanel.RenderTransform>
                <ContentControl Template="{StaticResource SettingsSubHeader}" Tag="常规设置" />

                <Border Style="{StaticResource SettingsCard}">
                  <StackPanel>
                    <Grid Padding="16,13" ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="开机自启动" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="开机登录 Windows 后自动运行点波音乐" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                      <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource SettingsToggle}" Toggled="AutoStartToggle_Toggled" AutomationProperties.Name="开机自启动" />
                    </Grid>
                    <Border Style="{StaticResource Separator}" />
                    <Grid Padding="16,13" ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="开机自启时静默" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="开机自启动时不显示主界面，仅常驻于系统托盘" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                      <ToggleSwitch x:Name="SilentAutoStartToggle" Grid.Column="1" Style="{StaticResource SettingsToggle}" Toggled="SilentAutoStartToggle_Toggled" AutomationProperties.Name="开机自启时静默" />
                    </Grid>
                    <Border Style="{StaticResource Separator}" />
                    <Grid Padding="16,13" ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="启动时自动播放" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="应用启动完成后自动恢复上次播放进度并开始播放" Style="{StaticResource RowDescription}" />
                      </StackPanel>
                      <ToggleSwitch x:Name="AutoPlayOnLaunchToggle" Grid.Column="1" Style="{StaticResource SettingsToggle}" Toggled="AutoPlayOnLaunchToggle_Toggled" AutomationProperties.Name="启动时自动播放" />
